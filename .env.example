# Railway supplies PORT automatically. These values must be set in Railway Variables.
NODE_ENV=production
PORT=
HOST=0.0.0.0

# Required: use the connection string from your managed PostgreSQL service.
DATABASE_URL=
# Set to "disable" only when the database provider explicitly requires no TLS.
DATABASE_SSL=
PG_POOL_MAX=

# Required: use a private admin code (at least 16 characters) and random secret (at least 32).
ADMIN_CODE=
JWT_SECRET=

# Required S3-compatible storage credentials and public base URL for uploaded media.
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=
# Optional S3-compatible provider settings.
S3_REGION=auto
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=true

# Optional settings.
MAX_UPLOAD_MB=3072
CORS_ORIGIN=
OPENAI_API_KEY=
OPENAI_TTS_MODEL=gpt-4o-mini-tts
